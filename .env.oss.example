# Coasty OSS Mode — get a key at https://coasty.ai/developers
COASTY_API_KEY=

# CSRF_SECRET and ENCRYPTION_KEY are auto-generated into .env.local on first
# boot in OSS mode (lib/auto-secrets.ts) — no need to set them here.
# For production-style runs, set them explicitly instead:
#   CSRF_SECRET=    any opaque string (64 hex chars recommended)
#   ENCRYPTION_KEY= base64 of exactly 32 bytes (openssl rand -base64 32)
